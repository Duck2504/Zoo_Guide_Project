<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <!-- Gỡ bỏ WebDAV chặn POST/PUT/DELETE -->
    <modules>
      <remove name="WebDAVModule" />
    </modules>
    <handlers>
      <remove name="WebDAV" />
      <!-- Lệnh chạy C# mặc định (giữ nguyên tên dll của em) -->
      <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
    </handlers>

    <aspNetCore processPath="dotnet" arguments=".\ZooAudioGuide.API.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
  </system.webServer>
</configuration>