<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <modules>
      <!-- Gỡ WebDAV chặn POST/PUT/DELETE -->
      <remove name="WebDAVModule" />
    </modules>
    
    <handlers>
      <!-- Gỡ toàn bộ các rào cản chặn API của IIS -->
      <remove name="WebDAV" />
      <remove name="ExtensionlessUrlHandler-Integrated-4.0" />
      <remove name="OPTIONSVerbHandler" />
      <remove name="TRACEVerbHandler" />
      
      <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
    </handlers>

    <aspNetCore processPath="dotnet" arguments=".\ZooAudioGuide.API.dll" stdoutLogEnabled="false" hostingModel="inprocess" />
  </system.webServer>
</configuration>