<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <!-- 1. Bắt buộc IIS trả về lỗi nguyên bản của C# thay vì trang HTML chung chung -->
    <httpErrors existingResponse="PassThrough" />

    <modules>
      <remove name="WebDAVModule" />
    </modules>
    <handlers>
      <remove name="WebDAV" />
      <remove name="OPTIONSVerbHandler" />
      <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
    </handlers>

    <!-- 2. Bật tính năng ghi lỗi ra file text (đổi stdoutLogEnabled thành true) -->
    <aspNetCore processPath="dotnet" arguments=".\ZooAudioGuide.API.dll" stdoutLogEnabled="true" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
  </system.webServer>
</configuration>