<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <modules>
      <!-- Gỡ WebDAV để cho phép POST/PUT/DELETE -->
      <remove name="WebDAVModule" />
    </modules>
    <handlers>
      <remove name="WebDAV" />
      <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
    </handlers>
    
    <!-- Chạy inprocess mặc định, tắt log để không bị lỗi quyền thư mục -->
    <aspNetCore processPath="dotnet" arguments=".\ZooAudioGuide.API.dll" stdoutLogEnabled="false" hostingModel="outofprocess" />
  </system.webServer>
</configuration>