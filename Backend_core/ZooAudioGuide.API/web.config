<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <!-- Gỡ bỏ WebDAV để không bị chặn các API POST, PUT, DELETE -->
    <modules>
      <remove name="WebDAVModule" />
    </modules>
    <handlers>
      <remove name="WebDAV" />
    </handlers>
  </system.webServer>
</configuration>