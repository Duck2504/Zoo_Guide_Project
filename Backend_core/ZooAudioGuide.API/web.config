<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <!-- Lệnh này cực kỳ quan trọng để lột trần lỗi 500 -->
    <httpErrors errorMode="Detailed" existingResponse="PassThrough" />
    
    <modules>
      <remove name="WebDAVModule" />
    </modules>
    <handlers>
      <remove name="WebDAV" />
      <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
    </handlers>
    
    <!-- Tạm tắt ghi log file để tránh lỗi sập do chưa cấp quyền thư mục -->
    <aspNetCore processPath="dotnet" arguments=".\ZooAudioGuide.API.dll" stdoutLogEnabled="false" hostingModel="outofprocess" />
  </system.webServer>
</configuration>